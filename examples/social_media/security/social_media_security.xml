<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Security Groups -->
        <record id="group_social_media_user" model="res.groups">
            <field name="name">Social Media User</field>
            <field name="category_id" ref="base.module_category_marketing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Basic access to social media features</field>
        </record>
        
        <record id="group_social_media_manager" model="res.groups">
            <field name="name">Social Media Manager</field>
            <field name="category_id" ref="base.module_category_marketing"/>
            <field name="implied_ids" eval="[(4, ref('group_social_media_user'))]"/>
            <field name="comment">Can manage social media providers and settings</field>
        </record>
        
        
    </data>
</odoo>