<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Profile Tree View -->
        <record id="view_social_media_profile_tree" model="ir.ui.view">
            <field name="name">social.media.profile.tree</field>
            <field name="model">social_media.profile</field>
            <field name="arch" type="xml">
                <tree string="Social Media Profiles">
                    <field name="display_name"/>
                    <field name="username"/>
                    <field name="service"/>
                    <field name="account_id"/>
                    <field name="profile_type"/>
                    <field name="post_count"/>
                    <field name="last_fetched"/>
                    <button name="action_view_posts" type="object" string="View Posts" icon="fa-comments"/>
                </tree>
            </field>
        </record>
        
        <!-- Profile Form View -->
        <record id="view_social_media_profile_form" model="ir.ui.view">
            <field name="name">social.media.profile.form</field>
            <field name="model">social_media.profile</field>
            <field name="arch" type="xml">
                <form string="Social Media Profile">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_posts" type="object" class="oe_stat_button" icon="fa-comments">
                                <field name="post_count" widget="statinfo" string="Posts"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="display_name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="username"/>
                                <field name="external_profile_id"/>
                                <field name="profile_type"/>
                                <field name="service" readonly="1"/>
                            </group>
                            <group>
                                <field name="account_id"/>
                                <field name="user_id" readonly="1"/>
                                <field name="last_fetched"/>
                                <field name="post_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Profile Metadata" attrs="{'invisible': [('profile_metadata', '=', False)]}">
                            <field name="profile_metadata" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Posts">
                                <field name="post_ids">
                                    <tree>
                                        <field name="content"/>
                                        <field name="posted_at"/>
                                        <field name="engagement_stats"/>
                                        <field name="fetched_at"/>
                                        <button name="action_open_post_url" type="object" string="Open" icon="fa-external-link"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Profile Action -->
        <record id="action_social_media_profile" model="ir.actions.act_window">
            <field name="name">Social Media Profiles</field>
            <field name="res_model">social_media.profile</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No profiles found!
                </p>
                <p>
                    Profiles are automatically created when you sync your following list
                    from your connected social media accounts.
                </p>
            </field>
        </record>
        
        <!-- Profile Kanban View -->
        <record id="view_social_media_profile_kanban" model="ir.ui.view">
            <field name="name">social.media.profile.kanban</field>
            <field name="model">social_media.profile</field>
            <field name="arch" type="xml">
                <kanban string="Social Media Profiles">
                    <field name="display_name"/>
                    <field name="username"/>
                    <field name="service"/>
                    <field name="post_count"/>
                    <field name="profile_metadata"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="row">
                                        <div class="col-2">
                                            <t t-if="record.profile_metadata.raw_value">
                                                <t t-set="metadata" t-value="JSON.parse(record.profile_metadata.raw_value)"/>
                                                <t t-if="metadata.profile_image_url or metadata.picture">
                                                    <img class="oe_kanban_avatar" t-att-src="metadata.profile_image_url or metadata.picture" alt="Profile Picture"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="oe_kanban_avatar">
                                                        <i class="fa fa-user"/>
                                                    </span>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <span class="oe_kanban_avatar">
                                                    <i class="fa fa-user"/>
                                                </span>
                                            </t>
                                        </div>
                                        <div class="col-10">
                                            <strong><field name="display_name"/></strong>
                                            <br/>
                                            <field name="username"/>
                                            <br/>
                                            <span class="badge badge-pill badge-info"><field name="service"/></span>
                                            <span class="badge badge-pill badge-secondary"><field name="post_count"/> posts</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Add Kanban to action -->
        <record id="action_social_media_profile" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form</field>
        </record>
        
    </data>
</odoo>